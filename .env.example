DATA_PROVIDER=MT5
MT5_LOGIN=YOUR_IC_MARKETS_MT5_LOGIN
MT5_PASSWORD=YOUR_IC_MARKETS_MT5_PASSWORD
MT5_SERVER=ICMarketsSC-Demo
MT5_TERMINAL_PATH=

SYMBOLS=TARGET_FX_INDICES_GOLD
HISTORY_SIZE=150

# AUDIT and SCHEDULED modes scan only major/minor FX pairs, indices, and gold from the connected IC Markets MT5 terminal.
# SCHEDULED scans immediately at startup, then at 02:35 IST and every 4 hours (06:35, 10:35, 14:35, 18:35, 22:35...) and sends only completed alerts to Telegram.
RUN_MODE=SCHEDULED
DAILY_SCAN_HOUR=2
DAILY_SCAN_MINUTE=35
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Access control / admin panel
# ADMIN_TELEGRAM_ID should be your personal Telegram chat ID.
ADMIN_TELEGRAM_ID=
ADMIN_PANEL_PORT=8080
# Set a strong password before exposing the panel to the internet.
ADMIN_PANEL_PASSWORD=
